================================================================================
                    ANIME BOT ENVIRONMENT VARIABLES
================================================================================

# ============================================================================
# 1. TELEGRAM BOT (REQUIRED - Get from @BotFather)
# ============================================================================
SINOBANED2_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_admin_user_id_here

# For Vercel: Set this to your Vercel domain webhook
TELEGRAM_WEBHOOK_URL=https://your-vercel-project.vercel.app/api/bot

# ============================================================================
# 2. DATABASE (Choose one: SQLite or PostgreSQL)
# ============================================================================

# OPTION A: LOCAL TESTING (SQLite)
DATABASE_URL=sqlite:///anime_bot.db

# OPTION B: PRODUCTION (PostgreSQL - Supabase Free)
# Get from: supabase.com → Create project → Connection string
DATABASE_URL=postgresql://user:password@host:port/dbname

# ============================================================================
# 3. GROQ AI (For AI Recommendations & Summaries - FREE)
# ============================================================================
# Get free from: console.groq.com
# Steps:
#   1. Sign up at console.groq.com
#   2. Create API key
#   3. Paste below (generous free tier - great for testing!)
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# 4. PAYMENTS - Paystack (For Bot Clones - 50 GHS)
# ============================================================================
# Get from: paystack.com → Account → API Keys
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ============================================================================
# 5. PAYMENTS - Stripe (For Clone Bot Commissions)
# ============================================================================
# Get from: stripe.com → Account → API Keys
# Users will provide their own Stripe keys for their cloned bots
# This is for main bot transactions (optional, advanced)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLIC_KEY=your_stripe_public_key

# ============================================================================
# 6. SUBSCRIPTION SETTINGS
# ============================================================================
# Price per month for AI features (in GHS)
SUBSCRIPTION_PRICE=10

# Commission rate for cloned bot sales (0.10 = 10%)
CLONE_COMMISSION_RATE=0.10

# ============================================================================
# 7. VERCEL DEPLOYMENT (Only for Vercel)
# ============================================================================
# Node environment
NODE_ENV=production

# Vercel project settings
VERCEL_ENV=production
VERCEL_URL=your-vercel-project.vercel.app

# ============================================================================
# 8. OPTIONAL: MONITORING & LOGGING
# ============================================================================
# For error tracking (optional)
SENTRY_DSN=your_sentry_dsn_if_using

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
