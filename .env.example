# ── Core bot ─────────────────────────────────────────────────────────────
SINOBANED2_BOT_TOKEN=your_main_bot_token_from_botfather
ADMIN_ID=your_telegram_user_id

# Postgres connection string (Supabase, Neon, or Railway Postgres).
# SQLite is NOT usable — the app runs in a serverless/ephemeral container
# with no writable, persistent disk.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Fernet key used to encrypt clone bot_token / webhook_secret at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Shared secret checked against Telegram's X-Telegram-Bot-Api-Secret-Token
# header for the MAIN bot's webhook only (clones use their own per-clone
# secret, generated automatically and stored in the database).
TELEGRAM_WEBHOOK_SECRET=

# ── Real clone-bot system ───────────────────────────────────────────────
# Public HTTPS base URL this app is deployed at (your Vercel domain, no
# trailing slash). Required to register per-clone webhooks. Clone creation
# fails loudly if this isn't set.
PUBLIC_BASE_URL=https://your-deployment.vercel.app

# Rollback flag: set to "false" to instantly disable the real multi-tenant
# clone router and fall back to the old placeholder behavior.
CLONE_BOT_REAL_ENABLED=true

# Max number of per-clone Application instances kept warm in memory at once
# (bounded LRU cache).
CLONE_APP_CACHE_SIZE=20

# ── Payments ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Admin event logging (optional) ──────────────────────────────────────
# Telegram group/channel ID the bot posts admin events to (e.g. new clones,
# errors). Leave blank and this feature is simply disabled — no crash.
LOG_GROUP_ID=

# Invite link for the fixed-price (GHS 20, see config.PREMIUM_GROUP_FEE_GHS)
# "Pay to Join Premium Group" button attached to every broadcast. Leave
# blank and the paywall still works, but paid users won't get a join link.
PREMIUM_GROUP_INVITE_LINK=

# Numeric chat_id of the actual Premium Group (get it via /getchatid in that
# group). Required for the payment gate on join requests — without it,
# handlers/moderation.py can't tell the premium group apart from any other
# autodmjoin-enabled group, so join requests aren't checked against payment.
PREMIUM_GROUP_CHAT_ID=

# ── AI features ──────────────────────────────────────────────────────────
GROQ_API_KEY=

# Reverse image search (SerpApi — free tier, get a key at serpapi.com)
OPENAI_API_KEY=
FAL_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────
# Ephemeral cache dir only — never used for persistent data.
DATA_DIR=/tmp/data

# ── Autopost / broadcast cron endpoints ─────────────────────────────────
# Protects api/cron_autopost.py and api/cron_broadcast.py. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Vercel Cron sends this automatically as "Authorization: Bearer <value>"
# once set here AND in vercel.json. If you're on Vercel's Hobby plan (crons
# limited to once/day), instead ping these endpoints from an external
# scheduler (cron-job.org, a GitHub Actions scheduled workflow, etc.) with
# ?secret=<value> for real minute-level intervals — see vercel.json.
CRON_SECRET=
